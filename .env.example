PORT=4000
LEARNING_THRESHOLD=10
APP_URL=http://localhost:4000

# Session — OBBLIGATORIO in produzione (generare con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Admin reset — OBBLIGATORIO in produzione (generare con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_RESET_SECRET=

# SMTP
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Preventivo EASY
SMTP_FROM_EMAIL=

# Claude AI
CLAUDE_API_KEY=
# Limiti giornalieri API Claude (opzionale — default: 10 per utente, 500 globale)
CLAUDE_DAILY_USER_LIMIT=10
CLAUDE_DAILY_GLOBAL_LIMIT=500

# Logging (opzionale — default: info)
LOG_LEVEL=info

# Preventivi gratuiti per utente free (opzionale — default: 3)
FREE_QUOTE_LIMIT=3

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Backup offsite S3 (opzionale — compatibile con AWS S3, Backblaze B2, MinIO)
# Se non configurato, viene usato solo il backup locale (7 giorni di retention)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com  # per Backblaze B2 o MinIO

# Alert email per errori critici (uncaught exception, unhandled rejection)
# Usa l'account SMTP configurato sopra per inviare gli alert
ALERT_EMAIL=
